# Environment and secrets
.env
*.env.local
config.ini

# Vendored dependencies (built by build-dist.sh)
vendor/

# TLS certificates (generated by installer)
certs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# Logs (raw syslog data can be large)
logs/*.log
logs/*.gz
logs/*.export
*.export

# Generated reports
reports/*.xlsx
reports/*.json
reports/*.csv

# Test fixtures and golden files are derived from real ZPA logs and
# contain client PII (usernames, IPs, hostnames). Keep local-only; see
# tests/README.md for how to regenerate them on a dev machine.
tests/fixtures/
tests/golden/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Internal docs
cags_study/
specs/

# Claude Code / Spec Kit (local tooling)
.claude/
.specify/
.name
compound.local.md